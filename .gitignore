# `.gubia/` is local engine state, per repo and per process: it is not
# versioned except for the README and `logs/`'s `.gitkeep` (see .gubia/README.md).
# In particular `agent-probe.dump` is a dump of the real machine
# environment — it is regenerated on every `gubia run` and has no place
# in history.
.gubia/*
!.gubia/README.md
!.gubia/logs/
.gubia/logs/*
!.gubia/logs/.gitkeep

# Iteration witness for the repo-minimal fixture's e2e tests (task 10):
# regenerated on every run of the fake CLI and has no place in history.
.fixture-log/

plan/

# Local Obsidian config for vault/.
vault/.obsidian/